  @@index([tenantId, hostname])
  @@index([hostname])
  @@index([tenantId, assetClass])
  @@map("endpoints")
}

// ---------------------------------------------------------------------------
// AI agents — providers (online or local), per-agent profiles, run log.
// ---------------------------------------------------------------------------

enum AiAutonomy {
  OFF // agent disabled
  SUGGEST // analysis and recommendations only
  CONTAIN_WITH_APPROVAL // proposes containment; a human approves
  AUTO_CONTAIN // executes allowed containment above the confidence bar
}

// A client's AI choices (lib/ai/gateway): a provider per agent type, a
// monthly budget, and when budget alerts went out. What may run at all
// (residency, allowed providers, masking, user choice) is in the client's
// signed rulebook.
model TenantAiPolicy {
  tenantId           String   @id
  defaults           Json? // { [agentKey]: providerId }
  monthlyBudgetUsd   Float?
  budgetAlertMonth   String? // "2026-10" once the 80% alert went out
  budgetReachedMonth String? // once spend reached the budget
  updatedById        String?
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_policies")
}

// How well a model does each agent's job on the evaluation set
// (lib/ai/evals). A client-picked model without a passing score is capped at
// suggestions.
model ModelCapability {
  id          String   @id @default(cuid())
  model       String
  agentKey    String
  score       Float
  passed      Boolean
  cases       Int
  details     Json?
  evaluatedAt DateTime @default(now())

  @@unique([model, agentKey])
  @@map("model_capabilities")
}

model AiProvider {
  id               String    @id @default(cuid())
  name             String    @unique
  kind             String // anthropic | openai_compatible
  baseUrl          String?
  model            String
  apiKeyCipher     String?   @db.Text
  isLocal          Boolean   @default(false)
  enabled          Boolean   @default(true)
  isDefault        Boolean   @default(false)
  // Set for a client's own provider (bring your own key): used only for
  // that client. Null = a platform provider.
  tenantId         String?
  // Where inference runs, for region-locked clients ("india", "eu"…).
  region           String?
  lastCheckedAt    DateTime?
  lastCheckOk      Boolean?
  lastCheckMessage String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agents AiAgentProfile[]
  tenant Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("ai_providers")
}

model AiAgentProfile {
  id             String               @id @default(cuid())
  key            String               @unique // triage | containment | phishing | threat_intel | report | investigation
  name           String
  description    String?
  enabled        Boolean              @default(true)
  providerId     String? // null = platform default provider
  model          String? // overrides the provider's model
  autonomy       AiAutonomy           @default(SUGGEST)
  allowedActions PlaybookActionType[] @default([])
  minConfidence  Float                @default(0.8)
  effort         String               @default("medium") // low | medium | high
  instructions   String?              @db.Text
  updatedAt      DateTime             @updatedAt

  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@map("ai_agent_profiles")
}

model AiRun {
  id            String   @id @default(cuid())
  caseId        String?
  // The client the run was for, and why this model ran it (lib/ai/gateway).
  tenantId      String?
  resolution    Json?
  agentKey      String
  trigger       String // auto | manual
  engine        String // provider name, or "built-in"
  model         String?
  isLocal       Boolean  @default(false)
  status        String // succeeded | fallback | failed
  confidence    Float?
  output        Json?
  grounding     Json? // claims checked against case evidence
  error         String?  @db.Text
  durationMs    Int?
  inputTokens   Int?
  outputTokens  Int?
  requestedById String?
  feedback      String? // agree | disagree
  feedbackNote  String?
  feedbackById  String?
  createdAt     DateTime @default(now())

  case       Case?            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  feedbackBy User?            @relation("AiRunFeedback", fields: [feedbackById], references: [id], onDelete: SetNull)
  actions    ResponseAction[]

  @@index([caseId, createdAt])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("ai_runs")
}

// One containment step on one target, proposed by an AI agent or requested
// by an analyst, and gated by the response policy (src/lib/response/policy.ts).
enum OrgPolicyStatus {
  DRAFT
  AWAITING_SIGNATURE
  ACTIVE
  SUPERSEDED
}

// A client's rulebook (lib/rulebook): what HELIOS may do on its estate,
// versioned, hashed and signed by the client. One ACTIVE version at a time;
// the response policy reads it on every decision.
model OrgPolicy {
  id             String          @id @default(cuid())
  tenantId       String
  version        Int
  status         OrgPolicyStatus @default(DRAFT)
  body           Json
  contentHash    String
  template       String?
  reason         String?         @db.Text
  authoredById   String?
  authoredByName String
  submittedAt    DateTime?
  signedById     String?
  signedByName   String?
  signedAt       DateTime?
  signatureNote  String?         @db.Text
  effectiveFrom  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, version])
  @@index([tenantId, status])
  @@map("org_policies")
}

// Known-good activity a client vouches for (a vulnerability scanner, an
// admin tool, an expected job): each with an owner, a reason and an expiry.
model PolicyAllowlistEntry {
  id          String    @id @default(cuid())
  tenantId    String
  kind        String // ip | host | user | domain | hash | process | sender
  value       String
  reason      String
  owner       String
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, kind, value])
  @@map("policy_allowlist")
}

enum ResponseActionStatus {
  SUGGESTED // recommendation only — autonomy doesn't allow acting
  PENDING_APPROVAL
  EXECUTED
  REJECTED
  FAILED
  BLOCKED // failed a guardrail (ungrounded target, kill switch, ...)
  ROLLED_BACK
  // Approved, but no response connector can carry it out: someone does it
  // in the tool's own console and marks it done here.
  MANUAL_REQUIRED
  // Shadow mode: what the AI would have done, recorded silently and shown
  // only once the case is closed (lib/shadow).
  SHADOW
  // A native connector asked the vendor; waiting for the vendor's state to
  // confirm it (lib/connectors/verify). Never counts as containment.
  IN_PROGRESS
}

// How far AI may go for one client and one action type, earned in shadow
// mode (lib/shadow/ladder.ts): 0 observe, 1 suggest, 2 approve, 3 act and
// notify, 4 act. A promotion waits for the client's approval.
model AutonomyLevel {
  tenantId      String
  actionType    PlaybookActionType
  level         Int
  reason        String?
  changedByName String
  proposedLevel Int?
  proposedAt    DateTime?
  proposalStats Json?
  updatedAt     DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, actionType])
  @@map("autonomy_levels")
}

// One AI decision scored against what analysts did, when its case closed.
model AiDecisionOutcome {
  id               String              @id @default(cuid())
  tenantId         String?
  caseId           String
  kind             String // action | verdict
  actionType       PlaybookActionType?
  target           String?
  level            Int? // the ladder level when the AI decided
  aiOutcome        String // the policy outcome the AI got (or would have, in shadow); for a verdict, the AI's verdict; NONE when only a human acted
  humanOutcome     String // took | did_not; for a verdict, the disposition
  agreed           Boolean
  falseContainment Boolean             @default(false)
  critical         Boolean             @default(false)
  severity         CaseSeverity
  createdAt        DateTime            @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([tenantId, actionType, createdAt])
  @@index([caseId])
  @@map("ai_decision_outcomes")
}

model ResponseAction {
  id                String               @id @default(cuid())
  caseId            String
  tenantId          String?
  actionType        PlaybookActionType
  target            String?
  parameters        Json?
  source            String // ai | analyst
  status            ResponseActionStatus
  rationale         String?              @db.Text
  confidence        Float?
  policyReason      String?
  aiRunId           String?
  requestedById     String?
  decidedById       String?
  decidedAt         DateTime?
  // The two-person rule: approvals needed, and who has approved so far
  // ([{ id, name, at }]).
  requiredApprovals Int                  @default(1)
  approvals         Json?
  // The client rulebook version that decided, and every rule that
  // restricted the action (lib/response/policy.ts).
  policyVersion     Int?
  policyHash        String?
  trace             Json?
  // Where it is in the client's approver chain: { step, at, timedOut }.
  escalation        Json?
  // Time-boxed actions (an IP block, a temporary disable) roll themselves
  // back at this time unless someone extends them.
  expiresAt         DateTime?
  result            Json?
  // A QA reviewer's call on an action the AI ran on its own: right | wrong.
  qaVerdict         String?
  createdAt         DateTime             @default(now())

  case  Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  aiRun AiRun? @relation(fields: [aiRunId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([caseId])
  @@map("response_actions")
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Commercial — quotes from the Build & Price configurator.
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  LOST
}

model Quote {
  id           String      @id @default(cuid())
  reference    String      @unique // Q-2026-0001
  clientName   String
  tenantId     String?
  status       QuoteStatus @default(DRAFT)
  currency     String      @default("USD")
  config       Json
  totals       Json
  notes        String?     @db.Text
  validUntil   DateTime?
  // app: built in Build & Price · website: requested from the public estimator
  source       String      @default("app")
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source, createdAt])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Reference data — all admin-managed. The seed only loads verifiable facts
// (published vendor list prices with their source, Anthropic's published
// model prices, public threat feeds); company policy such as rates, SLAs and
// exchange rates starts empty.
// ---------------------------------------------------------------------------

model ServicePlan {
  id                 String     @id @default(cuid())
  key                String     @unique
  name               String
  tagline            String?
  coverage           String // e.g. "24x7", "8x5"
  // Minutes to acknowledge / contain, by severity ({ "CRITICAL": 30, ... }).
  ackMinutes         Json
  containMinutes     Json
  irRetainerHours    Int        @default(0)
  pricePerEndpoint   Float? // monthly sell price, USD
  costPerEndpoint    Float? // your monthly delivery cost, USD
  onboardingMinimum  Float?
  defaultAutonomyCap AiAutonomy @default(CONTAIN_WITH_APPROVAL)
  features           Json // { "threatHunting": "Monthly", ... }
  active             Boolean    @default(true)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenants Tenant[]

  @@map("service_plans")
}

// Your own service rates and commercial terms (keys in src/lib/pricing/items.ts).
model PriceItem {
  key         String   @id
  group       String
  label       String
  unit        String
  price       Float?
  cost        Float?
  note        String?
  sortOrder   Int      @default(0)
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("price_items")
}

model VolumeDiscount {
  minEndpoints Int      @id
  discountPct  Float
  updatedAt    DateTime @updatedAt

  @@map("volume_discounts")
}

// Third-party security tools HELIOS can onboard and price.
model CatalogTool {
  key            String               @id
  name           String
  vendor         String
  category       String
  description    String
  controls       String[]
  actions        PlaybookActionType[]
  ingest         String? // payload mapper, src/lib/integrations/mappers.ts
  platforms      String[]
  deployment     String
  offlineCapable Boolean              @default(false)
  priceUnit      String // endpoint | user | server | gb | flat
  // Vendor-published list price, USD per unit per month, with its source.
  listPrice      Float?
  priceSource    String?
  // What you actually pay or resell at; overrides listPrice in quotes.
  customPrice    Float?
  active         Boolean              @default(true)
  updatedAt      DateTime             @updatedAt

  @@map("catalog_tools")
}

model Currency {
  code        String   @id // ISO 4217
  symbol      String
  rate        Float // units per 1 USD
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("currencies")
}

// Model prices for AI spend estimates (USD per million tokens).
model AiModelPrice {
  model     String   @id
  provider  String
  inputPer  Float
  outputPer Float
  source    String?
  updatedAt DateTime @updatedAt

  @@map("ai_model_prices")
}

// Public or private indicator feeds imported into the threat-intel store.
model ThreatFeed {
  id             String        @id @default(cuid())
  name           String        @unique
  url            String
  indicatorType  IndicatorType
  maliciousScore Float         @default(0.8)
  description    String?
  enabled        Boolean       @default(false)
  lastImportedAt DateTime?
  lastCount      Int?
  lastError      String?
  createdAt      DateTime      @default(now())

  @@map("threat_feeds")
}

// A client's own data key (lib/keys): it seals that client's credentials
// and is itself stored wrapped by the platform's master key. Rotation adds
// a version and re-seals; destroying the keys makes the client's stored
// credentials unreadable (offboarding).
model TenantKey {
  id          String    @id @default(cuid())
  tenantId    String
  version     Int
  wrapped     String
  createdAt   DateTime  @default(now())
  retiredAt   DateTime?
  destroyedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, version])
  @@map("tenant_keys")
}

// ---------------------------------------------------------------------------
// Regulatory reporting (lib/compliance): what a client must tell a regulator
// or the people affected about an incident, and by when. CERT-In: report
// within 6 hours of noticing an incident of an Annexure I type. DPDP Rule 7:
// intimate the Data Protection Board and each affected Data Principal
// without delay, and send the Board a detailed report within 72 hours.
// HELIOS drafts, the client approves, and the filing is recorded.
// ---------------------------------------------------------------------------

enum NoticeKind {
  CERT_IN
  DPDP_INTIMATION // first intimation to the Data Protection Board
  DPDP_REPORT // detailed report to the Board
  DPDP_PRINCIPALS // the notice to each affected Data Principal
}

enum NoticeStatus {
  DRAFT
  AWAITING_APPROVAL // with the client
  APPROVED
  SUBMITTED
  NOT_REQUIRED
}

model RegulatoryNotice {
  id                String       @id @default(cuid())
  tenantId          String
  caseId            String
  kind              NoticeKind
  // 1 = the first report; later ones are updates to it.
  sequence          Int          @default(1)
  status            NoticeStatus @default(DRAFT)
  // When the clock started: the incident noticed (CERT-In) or the client
  // becoming aware of the personal data breach (DPDP).
  clockStartAt      DateTime
  // null = "without delay", with no target set.
  dueAt             DateTime?
  // CERT-In Annexure I items (lib/compliance/cert-in.ts).
  categories        String[]     @default([])
  // The report's fields, per kind.
  content           Json
  // "rules" (proposed by the classifier) or "analyst".
  proposedBy        String
  reasons           Json?
  approvedById      String?
  approvedByName    String?
  // How the client approved: app, or the channel staff recorded it from.
  approvedVia       String?
  approvedAt        DateTime?
  submittedAt       DateTime?
  submittedById     String?
  submittedVia      String? // email | portal | phone | client | other
  // The regulator's acknowledgement or tracking number.
  reference         String?
  // For notices to people: how many were told.
  recipientsCount   Int?
  messageId         String?
  notRequiredReason String?      @db.Text
  // Reminders sent so far (lib/compliance/service.ts).
  remindedStage     Int          @default(0)
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, kind, sequence])
  @@index([tenantId, status])
  @@index([status, dueAt])
  @@map("regulatory_notices")
}

// ---------------------------------------------------------------------------
// Alerts outside HELIOS (lib/alerts): every email, SMS, WhatsApp message or
// gateway webhook goes through this outbox. A worker sends each one, retries
// with backoff and records the outcome, so a slow provider never holds up the
// request that raised the alert and nothing is lost on a restart.
// ---------------------------------------------------------------------------

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // not sent on purpose: rate limit, channel not set up
}

model AlertDelivery {
  id            String              @id @default(cuid())
  // The HELIOS user it's for; null for a contact outside HELIOS (an
  // approver reached by phone number or email address).
  userId        String?
  tenantId      String?
  channel       String // email | sms | whatsapp
  to            String
  kind          String
  subject       String
  body          String              @db.Text
  href          String?
  caseId        String?
  status        AlertDeliveryStatus @default(PENDING)
  attempts      Int                 @default(0)
  // When the worker may (re)try it; claiming it pushes this forward.
  nextAttemptAt DateTime            @default(now())
  lastError     String?             @db.Text
  // The provider's message id (SMTP Message-ID, Twilio SID).
  providerRef   String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([to, createdAt])
  @@map("alert_deliveries")
}

// ---------------------------------------------------------------------------
// Detection engineering (lib/detections): Sigma rules imported by detection
// engineers, and per-client tuning of every detector and rule.
// ---------------------------------------------------------------------------

enum DetectionRuleStatus {
  TESTING // matches are counted, no cases open
  ACTIVE
  DISABLED
}

model DetectionRule {
  id          String              @id @default(cuid())
  // The rule's own Sigma id (or a hash of its text when it has none).
  sigmaId     String
  title       String
  description String?             @db.Text
  level       String // informational | low | medium | high | critical
  status      DetectionRuleStatus @default(TESTING)
  // null = every client; set = one client's own rule.
  tenantId    String?
  yaml        String              @db.Text
  techniques  String[]            @default([])
  tactics     String[]            @default([])
  logsource   String
  // What the import found that may stop it matching (unmapped log source…).
  warnings    String[]            @default([])
  testHits    Int                 @default(0)
  lastHitAt   DateTime?
  // The last few events it matched, for review before it goes live.
  samples     Json?
  createdById String?
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([sigmaId])
  @@map("detection_rules")
}

model DetectionTuning {
  id          String        @id @default(cuid())
  tenantId    String
  // A built-in detector's name, "sigma:<sigmaId>", or "*" for every one.
  target      String
  kind        String // exclude | disable | severity
  // exclude: events matching this condition don't count.
  field       String? // host | user | process | ip | text
  op          String? // equals | contains | startswith | endswith | regex
  value       String?
  severity    CaseSeverity?
  reason      String        @db.Text
  expiresAt   DateTime?
  hits        Int           @default(0)
  lastHitAt   DateTime?
  createdById String?
  createdAt   DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("detection_tunings")
}

// ---------------------------------------------------------------------------
// Log retention (lib/retention): archived event chunks and legal holds.
// ---------------------------------------------------------------------------

// One day's events of one client, as a compressed, encrypted object in the
// archive store. The object's own key is sealed with the client's data key,
// so destroying that key makes the archive unreadable too.
model EventArchive {
  id           String    @id @default(cuid())
  tenantId     String?
  day          DateTime // the UTC day the events are from
  part         Int       @default(1)
  storage      String // local | s3
  objectKey    String
  events       Int
  bytes        Int
  // SHA-256 of the stored object, checked on every read.
  sha256       String
  keySealed    String
  firstAt      DateTime
  lastAt       DateTime
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deleteReason String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, day])
  @@index([deletedAt, day])
  @@map("event_archives")
}

// Nothing in its range is deleted while a hold is in force, whatever the
// retention says.
model LegalHold {
  id            String    @id @default(cuid())
  tenantId      String
  caseId        String?
  reason        String    @db.Text
  fromAt        DateTime
  // null = open-ended.
  toAt          DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  releasedAt    DateTime?
  releasedById  String?
  releaseReason String?   @db.Text

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("legal_holds")
}

// ---------------------------------------------------------------- SOC operations

// The on-call rota: who answers pages, and when. An override (a swap or
// cover) takes precedence over the regular rotation for its hours.
model OnCallShift {
  id            String    @id @default(cuid())
  userId        String
  // primary | backup
  role          String    @default("primary")
  startsAt      DateTime
  endsAt        DateTime
  override      Boolean   @default(false)
  note          String?
  // The handoff summary sent at the start of the shift.
  handoffSentAt DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
  @@map("oncall_shifts")
}

// A page to whoever is on call, escalating (primary, backup, SOC managers)
// until someone acknowledges it.
model OnCallPage {
  id          String        @id @default(cuid())
  // One page per cause, e.g. case:<id>.
  key         String        @unique
  tenantId    String?
  caseId      String?
  title       String
  body        String?       @db.Text
  severity    CaseSeverity?
  // 0 primary, 1 backup, 2 SOC managers.
  level       Int           @default(0)
  pagedIds    String[]      @default([])
  lastPagedAt DateTime      @default(now())
  createdById String?
  createdAt   DateTime      @default(now())
  ackAt       DateTime?
  ackById     String?
  ackByName   String?

  @@index([ackAt, lastPagedAt])
  @@map("oncall_pages")
}

// A procedure for analysts, attached to the cases it matches: a checklist
// of steps, some required before a true positive is closed. Global
// (tenantId null) or one client's own.
model Runbook {
  id          String   @id @default(cuid())
  tenantId    String?
  title       String
  description String?  @db.Text
  // { sources, techniques, keywords, minSeverity } (lib/runbooks/match.ts).
  match       Json
  // [{ id, title, detail, required }]
  steps       Json
  version     Int      @default(1)
  enabled     Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases CaseRunbook[]

  @@index([tenantId])
  @@map("runbooks")
}

// A runbook on a case: the steps as they were when attached, and progress.
model CaseRunbook {
  id          String    @id @default(cuid())
  caseId      String
  tenantId    String?
  runbookId   String?
  title       String
  version     Int
  steps       Json
  // stepId → { by, byId, at, note, skipped }
  progress    Json      @default("{}")
  // "matched" or the name of who attached it.
  attachedBy  String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  case    Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  runbook Runbook? @relation(fields: [runbookId], references: [id], onDelete: SetNull)

  @@unique([caseId, runbookId])
  @@index([tenantId])
  @@map("case_runbooks")
}

// A case sampled for a human to check what the AI did on its own: actions
// it ran without a person, or a case it called benign.
model QaReview {
  id           String    @id @default(cuid())
  tenantId     String?
  caseId       String
  // Monday 00:00 UTC of the week sampled.
  week         DateTime
  reasons      String[]
  weight       Float
  reviewerId   String?
  // PENDING | DONE
  status       String    @default("PENDING")
  // Whether the AI's verdict was right (null: it gave none).
  verdictRight Boolean?
  // agree | partly | disagree
  outcome      String?
  notes        String?   @db.Text
  reviewedById String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, week])
  @@index([week, status])
  @@index([tenantId])
  @@map("qa_reviews")
}

// One daily digest sent: to a client's admins, or the SOC's own.
model DigestRun {
  id         String   @id @default(cuid())
  // <tenantId or "soc">:<YYYY-MM-DD>
  key        String   @unique
  tenantId   String?
  day        DateTime
  fromAt     DateTime
  toAt       DateTime
  recipients Int
  summary    Json
  createdAt  DateTime @default(now())

  @@index([tenantId, day])
  @@map("digest_runs")
}

// ---------------------------------------------------------------- business

enum ContractKind {
  PILOT
  SUBSCRIPTION
}

enum ContractStatus {
  DRAFT
  SENT
  ACTIVE
  ENDED
  TERMINATED
}

// A client's contract: a pilot or a subscription. Fees in minor units of
// its currency. Signing records who signed and snapshots what automated
// containment was agreed: the autonomy the client consented to, the
// rulebook version in force, and the liability cap.
model Contract {
  id                 String         @id @default(cuid())
  // C-2026-0001 (subscription) or P-2026-0001 (pilot).
  reference          String         @unique
  tenantId           String
  kind               ContractKind
  status             ContractStatus @default(DRAFT)
  quoteId            String?
  planName           String?
  currency           String
  monthlyFee         Int            @default(0)
  endpointsCommitted Int            @default(0)
  overagePerEndpoint Int            @default(0)
  oneTimeFee         Int            @default(0)
  // monthly | quarterly | annual
  billingCycle       String         @default("monthly")
  paymentTermsDays   Int            @default(30)
  startsAt           DateTime
  endsAt             DateTime
  // The term's length; a renewal adds another.
  termMonths         Int            @default(12)
  autoRenew          Boolean        @default(false)
  noticeDays         Int            @default(30)
  // Liability for automated containment, capped at this many months of fees.
  liabilityCapMonths Int            @default(12)
  // Snapshots taken when sent or signed.
  autonomyCap        AiAutonomy?
  rulebookVersion    Int?
  dpaReference       String?
  terms              String?        @db.Text
  // Pilots: [{ metric, target }] and the result.
  successCriteria    Json?
  pilotOutcome       String?
  convertedToId      String?
  // Invoices exist for periods up to here.
  billedThrough      DateTime?
  sentAt             DateTime?
  signedAt           DateTime?
  signedByName       String?
  signedByTitle      String?
  // in_app | paper | e_sign
  signedVia          String?
  signedRecordedById String?
  endedAt            DateTime?
  endReason          String?
  remindedAt         DateTime?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@index([tenantId])
  @@index([status, endsAt])
  @@map("contracts")
}

// An invoice for one billing period of a contract. Drafted by the job,
// numbered and frozen when issued; never deleted (voided with a reason).
model Invoice {
  id         String    @id @default(cuid())
  // <prefix>/<financial year>/<serial>, assigned when issued.
  number     String?   @unique
  tenantId   String
  contractId String?
  // DRAFT | ISSUED | PAID | VOID
  status     String    @default("DRAFT")
  currency   String
  periodFrom DateTime
  periodTo   DateTime
  // [{ description, quantity, unitPrice, amount }], minor units.
  lines      Json
  subtotal   Int
  // intra | inter | export | none
  taxMode    String?
  taxLines   Json?
  total      Int
  // Supplier and recipient as they were when issued.
  supplier   Json?
  recipient  Json?
  sac        String?
  issuedAt   DateTime?
  dueAt      DateTime?
  paidAt     DateTime?
  paymentRef String?
  voidedAt   DateTime?
  voidReason String?
  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([contractId, periodFrom])
  @@index([tenantId])
  @@index([status, dueAt])
  @@map("invoices")
}
