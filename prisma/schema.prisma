// HELIOS unified schema
// Consolidates aegis (agent governance), asip (SOC investigations),
// desas (email/file forensics), and signal-fusion (SIEM alerts) into
// one shared data model. See /legacy/components/* for the four
// original per-app schemas this replaces.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth + tenancy
// ---------------------------------------------------------------------------

// PLATFORM_* roles have organizationId = null and operate across every
// tenant (the "minimal workforce operates everything" model). ORG_* roles
// are scoped to exactly one Organization. There is no generic "ADMIN"
// anymore — platform vs. tenant admin are distinct, since they see
// different data and different nav.
enum UserRole {
  PLATFORM_OWNER
  PLATFORM_ANALYST
  ORG_ADMIN
  ORG_ANALYST
  ORG_VIEWER
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

// Which AI tier powers this org's investigations/governance LLM calls.
// Priced via Plan (one Plan row per ServiceType x AiTier combination) —
// this field is the operative setting the platform owner flips after a
// plan is purchased; see src/lib/investigations/llm.ts for the tier ->
// model mapping.
enum AiTier {
  ESSENTIAL // Claude Haiku — cheapest/fastest, triage-grade automation
  PROFESSIONAL // Claude Sonnet — default, real investigation work
  ENTERPRISE // Claude Opus — deepest reasoning, highest price
  SELF_HOSTED // customer's own Ollama endpoint (selfHostedOllamaUrl)
}

// A customer tenant of the MSSP platform. Admin-provisioned only (no
// public signup) — created by a PLATFORM_OWNER via /admin/organizations.
model Organization {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  status              OrganizationStatus @default(TRIAL)
  aiTier              AiTier             @default(ESSENTIAL)
  selfHostedOllamaUrl String?
  createdAt           DateTime           @default(now())

  users           User[]
  cases           Case[]
  agents          Agent[]
  ingestedEvents  IngestedEvent[]
  playbooks       Playbook[]
  auditLogs       AuditLog[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  pentestRequests PentestRequest[]
  integrations    Integration[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String?
  role           UserRole @default(ORG_VIEWER)
  organizationId String? // null for PLATFORM_OWNER / PLATFORM_ANALYST
  createdAt      DateTime @default(now())

  organization            Organization?      @relation(fields: [organizationId], references: [id])
  accounts                Account[]
  sessions                Session[]
  assignedCases           Case[]             @relation("CaseAssignee")
  auditLogs               AuditLog[]
  approvals               PlaybookApproval[]
  pentestRequestsMade     PentestRequest[]   @relation("PentestRequestedBy")
  pentestRequestsAssigned PentestRequest[]   @relation("PentestAssignee")

  @@index([organizationId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Unified case model — replaces aegis.BreachInvestigation, asip.Investigation,
// desas's per-email AnalysisResult, and signal-fusion.Alert.
// ---------------------------------------------------------------------------

enum CaseSource {
  AGENT_GOVERNANCE // aegis
  SOC_INVESTIGATION // asip
  EMAIL_ANALYSIS // desas
  SIEM_ALERT // signal-fusion
  PENETRATION_TEST // pentest-as-a-service findings delivery
}

enum CaseSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  OPEN
  TRIAGING
  INVESTIGATING
  AWAITING_APPROVAL
  CONTAINED
  RESOLVED
  FALSE_POSITIVE
}

model Case {
  id                 String       @id @default(cuid())
  organizationId     String? // null = platform-internal/demo case; every real tenant case is scoped
  sourceType         CaseSource
  title              String
  summary            String?      @db.Text
  severity           CaseSeverity @default(MEDIUM)
  status             CaseStatus   @default(OPEN)
  confidence         Float? // 0-1, e.g. asip's QA-validated confidence score
  verdict            String? // e.g. desas "malicious"/"suspicious"/"clean"
  riskScore          Float?
  assignedToId       String?
  sourceRef          String? // originating agentId / investigationId / alertId / emailId
  rootCauseNarrative String?      @db.Text
  metadata           Json? // source-specific payload (headers, IOC lists, etc.)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  resolvedAt         DateTime?

  organization    Organization?        @relation(fields: [organizationId], references: [id])
  assignedTo      User?                @relation("CaseAssignee", fields: [assignedToId], references: [id])
  detections      Detection[]
  timeline        TimelineEntry[]
  mitreTechniques CaseMitreTechnique[]
  indicators      CaseIndicator[]
  playbookRuns    PlaybookExecution[]
  auditLogs       AuditLog[]
  ingestedEvents  IngestedEvent[]
  pentestRequest  PentestRequest?

  @@index([organizationId])
  @@index([sourceType, status])
  @@index([severity])
  @@map("cases")
}

// One shared timeline for every case, replacing asip.TimelineEntry,
// aegis's JSON evidence blob, and desas's per-analysis narrative.
model TimelineEntry {
  id         String   @id @default(cuid())
  caseId     String
  occurredAt DateTime
  actor      String? // process/user/agent name
  action     String
  detail     String?  @db.Text
  evidence   Json?
  createdAt  DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, occurredAt])
  @@map("timeline_entries")
}

// Replaces signal-fusion's 11 detector outputs, aegis's DLP/reasoning/
// behavioral/trust triggers, and desas's forensic rule hits.
enum DetectionSource {
  GEO_VELOCITY
  FSM_CHAIN
  ANOMALOUS_ACTION
  THREAT_INTEL_MATCH
  RECONNAISSANCE
  CREDENTIAL_HARVESTING
  LATERAL_MOVEMENT
  DATA_EXFILTRATION
  PERSISTENCE
  DEFENSE_EVASION
  IMPACT
  AGENT_INTENT_POLICY
  AGENT_DLP
  AGENT_REASONING_DRIFT
  AGENT_TRUST_DECAY
  EMAIL_HEADER_AUTH
  EMAIL_BODY_URL
  EMAIL_ATTACHMENT_FORENSICS
  EMAIL_SANDBOX_DETONATION
}

model Detection {
  id        String          @id @default(cuid())
  caseId    String
  source    DetectionSource
  ruleId    String
  title     String
  severity  CaseSeverity
  evidence  Json
  createdAt DateTime        @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([source])
  @@map("detections")
}

// ---------------------------------------------------------------------------
// Ingested telemetry — raw normalized events the detection engine and
// Investigations run against. Replaces signal-fusion's Event model.
// caseId is a convenience marker for "has at least one detector claimed
// this event" (used to skip already-processed events on the next
// detection run) — it is NOT authoritative for "which events fed this
// case", since one event can match several detectors and the field can
// only point at one of the resulting cases. For that, read
// Detection.evidence.matchedEventIds on the case in question instead.
// ---------------------------------------------------------------------------

enum EventSource {
  AUTH
  ENDPOINT
  NETWORK
  CLOUD
}

model IngestedEvent {
  id             String       @id @default(cuid())
  organizationId String?
  source         EventSource
  eventType      String
  timestamp      DateTime
  ingestedAt     DateTime     @default(now())
  actorUser      String?
  actorProcess   String?
  actorService   String?
  sourceIp       String?
  destIp         String?
  geo            String?
  severityHint   CaseSeverity @default(INFO)
  confidenceHint Float        @default(0.5)
  metadata       Json
  caseId         String?

  organization Organization? @relation(fields: [organizationId], references: [id])
  case         Case?         @relation(fields: [caseId], references: [id])

  @@index([organizationId])
  @@index([timestamp])
  @@index([actorUser])
  @@index([sourceIp])
  @@map("ingested_events")
}

// ---------------------------------------------------------------------------
// MITRE ATT&CK — one shared reference set for asip, desas, and signal-fusion
// mappings instead of three separate copies.
// ---------------------------------------------------------------------------

model MitreTactic {
  id         String           @id // e.g. "TA0001"
  name       String
  techniques MitreTechnique[]

  @@map("mitre_tactics")
}

model MitreTechnique {
  id             String  @id // e.g. "T1566" or "T1566.001"
  tacticId       String
  name           String
  description    String? @db.Text
  isSubtechnique Boolean @default(false)
  parentId       String?

  tactic MitreTactic          @relation(fields: [tacticId], references: [id])
  cases  CaseMitreTechnique[]

  @@map("mitre_techniques")
}

model CaseMitreTechnique {
  caseId      String
  techniqueId String
  confidence  Float?

  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  technique MitreTechnique @relation(fields: [techniqueId], references: [id])

  @@id([caseId, techniqueId])
  @@map("case_mitre_techniques")
}

// ---------------------------------------------------------------------------
// Threat intelligence — one shared IOC cache for asip, desas, signal-fusion
// (VirusTotal / AbuseIPDB / MxToolbox) instead of three ad hoc caches.
// ---------------------------------------------------------------------------

enum IndicatorType {
  IP
  DOMAIN
  URL
  FILE_HASH
  EMAIL_ADDRESS
}

model ThreatIndicator {
  id             String        @id @default(cuid())
  type           IndicatorType
  value          String
  maliciousScore Float? // normalized 0-1 across providers
  providerData   Json // raw VT / AbuseIPDB / MxToolbox responses
  lastCheckedAt  DateTime      @default(now())
  expiresAt      DateTime // cache TTL (24h default, matching signal-fusion)

  caseLinks CaseIndicator[]

  @@unique([type, value])
  @@index([expiresAt])
  @@map("threat_indicators")
}

model CaseIndicator {
  caseId      String
  indicatorId String
  role        String? // e.g. "c2_destination", "sender_ip", "dropped_file_hash"

  case      Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  indicator ThreatIndicator @relation(fields: [indicatorId], references: [id])

  @@id([caseId, indicatorId])
  @@map("case_indicators")
}

// ---------------------------------------------------------------------------
// Agent governance (aegis) — distinct concept, kept close to source model.
// ---------------------------------------------------------------------------

enum AgentStatus {
  ACTIVE
  ISOLATED
  REVOKED
}

model Agent {
  id             String      @id @default(cuid())
  organizationId String?
  name           String
  publicKey      String
  trust          Float       @default(100)
  level          Int         @default(10) // L0 (isolated) - L10 (full access)
  status         AgentStatus @default(ACTIVE)
  mode           String?
  createdAt      DateTime    @default(now())
  lastUpdateAt   DateTime    @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// Response playbooks (signal-fusion) — generalized to trigger from any
// Case, not just SIEM alerts.
// ---------------------------------------------------------------------------

model Playbook {
  id               String   @id @default(cuid())
  organizationId   String?
  name             String
  description      String?  @db.Text
  triggerCondition Json // e.g. { severity: "CRITICAL", sourceType: "SIEM_ALERT" }
  enabled          Boolean  @default(true)
  autoExecute      Boolean  @default(false)
  requireApproval  Boolean  @default(true)
  priority         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization?       @relation(fields: [organizationId], references: [id])
  actions      PlaybookAction[]
  executions   PlaybookExecution[]

  @@index([organizationId])
  @@map("playbooks")
}

enum PlaybookActionType {
  ISOLATE_HOST
  BLOCK_IP
  NOTIFY_SLACK
  CREATE_TICKET
  KILL_PROCESS
  COLLECT_LOGS
  REVOKE_AGENT
  RESTORE_AGENT
}

model PlaybookAction {
  id         String             @id @default(cuid())
  playbookId String
  name       String
  actionType PlaybookActionType
  parameters Json
  order      Int

  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@map("playbook_actions")
}

enum PlaybookExecutionStatus {
  PENDING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED
}

model PlaybookExecution {
  id         String                  @id @default(cuid())
  playbookId String
  caseId     String
  status     PlaybookExecutionStatus @default(PENDING_APPROVAL)
  results    Json?
  startedAt  DateTime                @default(now())
  finishedAt DateTime?

  playbook  Playbook           @relation(fields: [playbookId], references: [id])
  case      Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvals PlaybookApproval[]

  @@map("playbook_executions")
}

model PlaybookApproval {
  id          String   @id @default(cuid())
  executionId String
  approverId  String
  decision    String // "approved" | "rejected"
  notes       String?
  decidedAt   DateTime @default(now())

  execution PlaybookExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  approver  User              @relation(fields: [approverId], references: [id])

  @@map("playbook_approvals")
}

// ---------------------------------------------------------------------------
// Audit log — one hash-chained trail for every write action app-wide
// (generalized from aegis.AuditLog).
// ---------------------------------------------------------------------------

model AuditLog {
  // Strict insertion-order counter for the hash chain. createdAt (DB
  // `now()`, millisecond precision) is NOT used for chain ordering — a
  // burst of rapid writes (e.g. a detection run creating several cases
  // and their playbook executions back to back) can tie at the
  // millisecond, and without a deterministic tiebreaker `ORDER BY
  // createdAt` can replay entries out of the order they were actually
  // chained in, which fails verifyAuditChainIntegrity even though
  // nothing was tampered with. seq is a DB-generated serial, so it's
  // gapless-ordered exactly by commit order.
  seq            Int      @id @default(autoincrement())
  id             String   @unique @default(cuid())
  organizationId String? // null = platform-level action (e.g. creating an org, managing the plan catalog)
  actorId        String?
  caseId         String?
  action         String
  detail         Json?
  prevHash       String
  currentHash    String
  signature      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])
  // onDelete: Restrict (not the implicit default of SetNull for an
  // optional relation) is load-bearing: a real bug surfaced while adding
  // tests for this phase — SetNull meant deleting a Case retroactively
  // nulled out caseId on any AuditLog entry that referenced it, which
  // breaks that entry's currentHash forever (it was hashed with the real
  // caseId). Nothing in the app ever deletes a Case, so this was latent,
  // but the DB should refuse that deletion outright rather than silently
  // corrupting the audit trail's whole point.
  case         Case?         @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Service catalog + billing — admin-provisioned tenants purchase a Plan per
// service area; AI tier is priced into the Plan itself (one row per
// ServiceType x AiTier combination) so "customers choose their AI model and
// pricing follows" is a literal catalog lookup, not a side calculation.
// No live payment processor is wired up yet — Invoice.status is advanced
// manually by the platform owner (see src/lib/billing/). Stripe/etc. is a
// drop-in for a later pass: it would just flip Invoice.status on webhook.
// ---------------------------------------------------------------------------

enum ServiceType {
  ENDPOINT_SECURITY
  CLOUD_SECURITY
  NETWORK_SECURITY
  EMAIL_SECURITY
  AGENT_GOVERNANCE
  PENETRATION_TESTING
}

model Plan {
  id            String      @id @default(cuid())
  name          String
  serviceType   ServiceType
  aiTier        AiTier
  priceMonthly  Decimal     @db.Decimal(10, 2)
  includedUnits Json? // e.g. { "endpoints": 25 } — display-only cap, not enforced yet
  description   String?     @db.Text
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id               String             @id @default(cuid())
  organizationId   String
  planId           String
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
  canceledAt       DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id])
  plan         Plan              @relation(fields: [planId], references: [id])
  invoiceLines InvoiceLineItem[]

  @@index([organizationId])
  @@map("subscriptions")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  number         String        @unique
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("USD")
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAt         DateTime?
  notes          String?       @db.Text

  organization Organization      @relation(fields: [organizationId], references: [id])
  lineItems    InvoiceLineItem[]

  @@index([organizationId])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  subscriptionId String?
  description    String
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(10, 2)
  amount         Decimal @db.Decimal(10, 2)

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("invoice_line_items")
}

// ---------------------------------------------------------------------------
// Pentest-as-a-service — request/scheduling workflow. A human (platform
// staff or a contractor) performs the actual test; findings are delivered
// as an ordinary Case (sourceType PENETRATION_TEST) the customer can see.
// This is deliberately NOT an automated exploitation pipeline.
// ---------------------------------------------------------------------------

enum PentestRequestStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model PentestRequest {
  id             String               @id @default(cuid())
  organizationId String
  requestedById  String
  scope          Json // { targets: string[], testTypes: string[], notes?: string }
  status         PentestRequestStatus @default(REQUESTED)
  scheduledAt    DateTime?
  assignedToId   String?
  reportCaseId   String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  requestedBy  User         @relation("PentestRequestedBy", fields: [requestedById], references: [id])
  assignedTo   User?        @relation("PentestAssignee", fields: [assignedToId], references: [id])
  reportCase   Case?        @relation(fields: [reportCaseId], references: [id])

  @@index([organizationId])
  @@map("pentest_requests")
}

// ---------------------------------------------------------------------------
// Integrations — a vendor-agnostic webhook ingestion framework. Any tool
// that can POST a webhook (most SIEMs/EDRs/cloud security tools can) points
// at the generated URL; the payload is normalized into IngestedEvent and
// run through the existing detection engine. Real pull-based per-vendor API
// clients (CrowdStrike/Splunk/Wazuh/etc. specific actions like "isolate
// host via vendor API") are intentionally out of scope here — this is the
// extensible interface they would plug into once there's a real vendor
// credential to build/test against, not a simulation of having one.
// ---------------------------------------------------------------------------

enum IntegrationCategory {
  SIEM
  EDR
  CLOUD
  IDENTITY
  EMAIL
  OTHER
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

model Integration {
  id             String              @id @default(cuid())
  organizationId String
  vendorLabel    String // free-text display name, e.g. "CrowdStrike Falcon"
  category       IntegrationCategory
  status         IntegrationStatus   @default(DISCONNECTED)
  webhookSecret  String
  lastIngestAt   DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("integrations")
}
