// HELIOS unified schema
// Consolidates aegis (agent governance), asip (SOC investigations),
// desas (email/file forensics), and signal-fusion (SIEM alerts) into
// one shared data model. See /legacy/components/* for the four
// original per-app schemas this replaces.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

// What a user may do. The permission matrix lives in src/lib/rbac.ts; staff
// roles serve every client tenant, CLIENT_* roles see only their own.
enum UserRole {
  ANALYST // Tier-2 SOC analyst: primary analysis
  ADMIN // platform owner
  SOC_MANAGER
  TRIAGE_ANALYST // Tier-1
  INCIDENT_RESPONDER // Tier-3 / IR lead
  THREAT_HUNTER
  DETECTION_ENGINEER
  AUDITOR
  SALES
  CLIENT_ADMIN
  CLIENT_VIEWER
}

// Analyst queues. A case gets one domain; analysts with domains set see
// those queues (plus whatever is assigned to them).
enum SecurityDomain {
  ENDPOINT
  NETWORK
  EMAIL
  IDENTITY
  CLOUD
  AI_AGENTS
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  passwordHash String?
  role         UserRole         @default(ANALYST)
  tenantId     String? // set for client users; null for MSSP staff
  title        String?
  domains      SecurityDomain[] @default([])
  active       Boolean          @default(true)
  lastLoginAt  DateTime?
  failedLogins Int              @default(0)
  lockedUntil  DateTime?
  preferences  Json?
  createdAt    DateTime         @default(now())

  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accounts               Account[]
  sessions               Session[]
  assignedCases          Case[]                  @relation("CaseAssignee")
  auditLogs              AuditLog[]
  approvals              PlaybookApproval[]
  notifications          Notification[]
  comments               CaseComment[]
  watching               CaseWatcher[]
  integrationAssignments IntegrationAssignment[]
  quotes                 Quote[]
  aiFeedback             AiRun[]                 @relation("AiRunFeedback")
  apiTokens              ApiToken[]

  @@index([tenantId])
  @@map("users")
}

// Personal access tokens for the REST API (/api/v1). A token acts as its
// user — same role, client and queues — narrowed to read or read-write.
// Stored only as a SHA-256 hash.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  userId     String
  tokenHash  String    @unique
  prefix     String // first characters, to recognize it in lists
  canWrite   Boolean   @default(false)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Client tenants — the organizations the SOC protects.
// ---------------------------------------------------------------------------

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                String       @id @default(cuid())
  name              String       @unique
  slug              String       @unique
  industry          String?
  status            TenantStatus @default(ONBOARDING)
  planId            String? // the managed-service plan the client is on (sets its SLA)
  contactName       String?
  contactEmail      String?
  endpointsLicensed Int          @default(0)
  usersLicensed     Int          @default(0)
  // The most autonomy the client has consented to for AI agents acting on
  // its estate; caps every agent profile.
  aiAutonomyCap     AiAutonomy   @default(CONTAIN_WITH_APPROVAL)
  notes             String?      @db.Text
  // Test clients hold test data only: badged everywhere, kept out of
  // commercial figures, and never a real organization.
  isTest            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  plan         ServicePlan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  users        User[]
  cases        Case[]
  events       SecurityEvent[]
  endpoints    Endpoint[]
  integrations Integration[]
  agents       Agent[]
  quotes       Quote[]
  policies     OrgPolicy[]
  allowlist    PolicyAllowlistEntry[]
  aiProviders  AiProvider[]
  aiPolicy     TenantAiPolicy?

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Unified case model — replaces aegis.BreachInvestigation, asip.Investigation,
// desas's per-email AnalysisResult, and signal-fusion.Alert.
// ---------------------------------------------------------------------------

enum CaseSource {
  AGENT_GOVERNANCE // aegis
  SOC_INVESTIGATION // asip
  EMAIL_ANALYSIS // desas
  SIEM_ALERT // signal-fusion
}

enum CaseSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  OPEN
  TRIAGING
  INVESTIGATING
  AWAITING_APPROVAL
  CONTAINED
  RESOLVED
  FALSE_POSITIVE
}

model Case {
  id                 String          @id @default(cuid())
  sourceType         CaseSource
  title              String
  summary            String?         @db.Text
  severity           CaseSeverity    @default(MEDIUM)
  status             CaseStatus      @default(OPEN)
  confidence         Float? // 0-1, e.g. asip's QA-validated confidence score
  verdict            String? // e.g. desas "malicious"/"suspicious"/"clean"
  riskScore          Float?
  assignedToId       String?
  sourceRef          String? // originating agentId / investigationId / alertId / emailId
  rootCauseNarrative String?         @db.Text
  metadata           Json? // source-specific payload (headers, IOC lists, etc.)
  tenantId           String?
  domain             SecurityDomain?
  tier               Int             @default(1) // escalation tier: 1 triage, 2 analysis, 3 incident response
  slaDueAt           DateTime? // acknowledge-by deadline from the tenant's plan
  acknowledgedAt     DateTime?
  containedAt        DateTime?
  aiStatus           String? // queued | running | completed | failed | skipped
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  resolvedAt         DateTime?

  tenant          Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedTo      User?                @relation("CaseAssignee", fields: [assignedToId], references: [id])
  detections      Detection[]
  timeline        TimelineEntry[]
  mitreTechniques CaseMitreTechnique[]
  indicators      CaseIndicator[]
  playbookRuns    PlaybookExecution[]
  auditLogs       AuditLog[]
  events          SecurityEvent[]
  comments        CaseComment[]
  watchers        CaseWatcher[]
  aiRuns          AiRun[]
  notifications   Notification[]
  responseActions ResponseAction[]

  @@index([tenantId, status])
  @@index([domain, status])
  @@index([sourceType, status])
  @@index([sourceType, sourceRef])
  @@index([severity])
  @@map("cases")
}

// One shared timeline for every case, replacing asip.TimelineEntry,
// aegis's JSON evidence blob, and desas's per-analysis narrative.
model TimelineEntry {
  id         String   @id @default(cuid())
  caseId     String
  occurredAt DateTime
  actor      String? // process/user/agent name
  action     String
  detail     String?  @db.Text
  evidence   Json?
  createdAt  DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, occurredAt])
  @@map("timeline_entries")
}

// Normalized telemetry — one Universal Event Schema for signal-fusion's
// auth/endpoint/network/cloud adapters and asip's Sysmon/CrowdStrike/Splunk/
// Wazuh/Google SecOps parsers. Detection runs over a window of these rows;
// events tied to an investigation carry its caseId.
model SecurityEvent {
  id                String   @id @default(cuid())
  batchId           String? // one ingestion run / uploaded file
  caseId            String?
  timestamp         DateTime
  ingestedAt        DateTime @default(now())
  source            String // auth | endpoint | network | cloud | process | file | ...
  platform          String? // originating product/parser, e.g. "sysmon", "crowdstrike"
  eventType         String
  userName          String?
  hostName          String?
  service           String?
  processName       String?
  processPid        Int?
  parentProcessName String?
  parentProcessPid  Int?
  commandLine       String?  @db.Text
  sourceIp          String?
  destIp            String?
  destPort          Int?
  geo               String?
  filePath          String?  @db.Text
  fileHash          String?
  severityHint      String?
  metadata          Json?
  tenantId          String?
  integrationId     String? // set when pushed through an onboarded tool's webhook

  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, timestamp])
  @@index([timestamp])
  @@index([caseId])
  @@index([batchId])
  @@map("security_events")
}

// Replaces signal-fusion's 11 detector outputs, aegis's DLP/reasoning/
// behavioral/trust triggers, and desas's forensic rule hits.
enum DetectionSource {
  GEO_VELOCITY
  FSM_CHAIN
  ANOMALOUS_ACTION
  THREAT_INTEL_MATCH
  RECONNAISSANCE
  CREDENTIAL_HARVESTING
  LATERAL_MOVEMENT
  DATA_EXFILTRATION
  PERSISTENCE
  DEFENSE_EVASION
  IMPACT
  AGENT_INTENT_POLICY
  AGENT_DLP
  AGENT_REASONING_DRIFT
  AGENT_TRUST_DECAY
  EMAIL_HEADER_AUTH
  EMAIL_BODY_URL
  EMAIL_ATTACHMENT_FORENSICS
  EMAIL_SANDBOX_DETONATION
  VENDOR_ALERT // raised by an onboarded tool (EDR, identity, email gateway)
}

model Detection {
  id          String          @id @default(cuid())
  caseId      String
  source      DetectionSource
  ruleId      String
  title       String
  severity    CaseSeverity
  evidence    Json
  // Stable hash of detector + matched event IDs, so re-running detection over
  // an overlapping event window never files the same finding twice.
  fingerprint String?         @unique
  createdAt   DateTime        @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([source])
  @@map("detections")
}

// ---------------------------------------------------------------------------
// MITRE ATT&CK — one shared reference set for asip, desas, and signal-fusion
// mappings instead of three separate copies.
// ---------------------------------------------------------------------------

model MitreTactic {
  id         String           @id // e.g. "TA0001"
  name       String
  techniques MitreTechnique[]

  @@map("mitre_tactics")
}

model MitreTechnique {
  id             String  @id // e.g. "T1566" or "T1566.001"
  tacticId       String
  name           String
  description    String? @db.Text
  isSubtechnique Boolean @default(false)
  parentId       String?

  tactic MitreTactic          @relation(fields: [tacticId], references: [id])
  cases  CaseMitreTechnique[]

  @@map("mitre_techniques")
}

model CaseMitreTechnique {
  caseId      String
  techniqueId String
  confidence  Float?

  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  technique MitreTechnique @relation(fields: [techniqueId], references: [id])

  @@id([caseId, techniqueId])
  @@map("case_mitre_techniques")
}

// ---------------------------------------------------------------------------
// Threat intelligence — one shared IOC cache for asip, desas, signal-fusion
// (VirusTotal / AbuseIPDB / MxToolbox) instead of three ad hoc caches.
// ---------------------------------------------------------------------------

enum IndicatorType {
  IP
  DOMAIN
  URL
  FILE_HASH
  EMAIL_ADDRESS
}

model ThreatIndicator {
  id             String        @id @default(cuid())
  type           IndicatorType
  value          String
  maliciousScore Float? // normalized 0-1 across providers
  providerData   Json // raw VT / AbuseIPDB / MxToolbox responses
  sources        String[] // providers that contributed to maliciousScore
  blockedAt      DateTime? // set by the BLOCK_IP playbook action
  lastCheckedAt  DateTime      @default(now())
  expiresAt      DateTime // cache TTL (24h default, matching signal-fusion)

  caseLinks CaseIndicator[]

  @@unique([type, value])
  @@index([expiresAt])
  @@map("threat_indicators")
}

model CaseIndicator {
  caseId      String
  indicatorId String
  role        String? // e.g. "c2_destination", "sender_ip", "dropped_file_hash"

  case      Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  indicator ThreatIndicator @relation(fields: [indicatorId], references: [id])

  @@id([caseId, indicatorId])
  @@map("case_indicators")
}

// ---------------------------------------------------------------------------
// Agent governance (aegis) — distinct concept, kept close to source model.
// ---------------------------------------------------------------------------

enum AgentStatus {
  ACTIVE
  ISOLATED
  REVOKED
}

model Agent {
  id           String      @id @default(cuid())
  name         String      @unique
  publicKey    String
  trust        Float       @default(100)
  level        Int         @default(10) // L0 (isolated) - L10 (full access)
  status       AgentStatus @default(ACTIVE)
  mode         String?
  tenantId     String?
  // SHA-256 of the agent's API token for POST /api/governance/evaluate.
  apiTokenHash String?     @unique
  tokenPrefix  String?
  createdAt    DateTime    @default(now())
  lastUpdateAt DateTime    @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("agents")
}

// ---------------------------------------------------------------------------
// Response playbooks (signal-fusion) — generalized to trigger from any
// Case, not just SIEM alerts.
// ---------------------------------------------------------------------------

model Playbook {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  triggerCondition Json // e.g. { severity: "CRITICAL", sourceType: "SIEM_ALERT" }
  enabled          Boolean  @default(true)
  autoExecute      Boolean  @default(false)
  requireApproval  Boolean  @default(true)
  priority         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  actions    PlaybookAction[]
  executions PlaybookExecution[]

  @@map("playbooks")
}

enum PlaybookActionType {
  ISOLATE_HOST
  BLOCK_IP
  NOTIFY_SLACK
  CREATE_TICKET
  KILL_PROCESS
  COLLECT_LOGS
  REVOKE_AGENT
  RESTORE_AGENT
  DISABLE_USER
  QUARANTINE_FILE
  BLOCK_SENDER
  // Rollbacks for the containment actions above.
  RELEASE_HOST
  UNBLOCK_IP
  ENABLE_USER
}

model PlaybookAction {
  id         String             @id @default(cuid())
  playbookId String
  name       String
  actionType PlaybookActionType
  parameters Json
  order      Int

  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@map("playbook_actions")
}

enum PlaybookExecutionStatus {
  PENDING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED
}

model PlaybookExecution {
  id          String                  @id @default(cuid())
  playbookId  String
  caseId      String
  status      PlaybookExecutionStatus @default(PENDING_APPROVAL)
  triggeredBy String                  @default("auto") // auto | manual | retroactive
  results     Json?
  error       String?
  startedAt   DateTime                @default(now())
  finishedAt  DateTime?

  playbook  Playbook           @relation(fields: [playbookId], references: [id])
  case      Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvals PlaybookApproval[]

  @@index([status])
  @@map("playbook_executions")
}

model PlaybookApproval {
  id          String   @id @default(cuid())
  executionId String
  approverId  String
  decision    String // "approved" | "rejected"
  notes       String?
  decidedAt   DateTime @default(now())

  execution PlaybookExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  approver  User              @relation(fields: [approverId], references: [id])

  @@map("playbook_approvals")
}

// ---------------------------------------------------------------------------
// Audit log — one hash-chained trail for every write action app-wide
// (generalized from aegis.AuditLog).
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  // Monotonic chain position. createdAt alone can tie within a millisecond,
  // which would make the verification order ambiguous.
  seq         Int      @unique @default(autoincrement())
  actorId     String?
  caseId      String?
  action      String
  detail      Json?
  prevHash    String
  currentHash String
  signature   String?
  createdAt   DateTime @default(now())

  // Restrict, not SetNull: nulling these on delete would rewrite hashed
  // fields and break the chain. Close cases / deactivate users instead.
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  case  Case? @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Collaboration — discussion, watchers, notifications.
// ---------------------------------------------------------------------------

model CaseComment {
  id         String   @id @default(cuid())
  caseId     String
  authorId   String?
  authorName String
  kind       String   @default("comment") // comment | handoff | escalation | share | ai
  body       String   @db.Text
  // Internal comments are hidden from client users.
  internal   Boolean  @default(true)
  mentions   String[] @default([]) // user ids
  createdAt  DateTime @default(now())

  case   Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("case_comments")
}

model CaseWatcher {
  caseId    String
  userId    String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
  @@map("case_watchers")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // mention | assigned | escalated | shared | watching | approval | ai | sla
  title     String
  body      String?   @db.Text
  href      String?
  caseId    String?
  actorName String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Onboarded security tools and the endpoint estate they protect.
// ---------------------------------------------------------------------------

enum IntegrationStatus {
  PENDING // created, no data yet
  CONNECTED
  DEGRADED
  DISCONNECTED
}

model Integration {
  id              String            @id @default(cuid())
  tenantId        String?
  vendor          String // tool key, src/lib/integrations/catalog.ts
  category        String // category key
  name            String
  status          IntegrationStatus @default(PENDING)
  enabled         Boolean           @default(true)
  config          Json? // non-secret settings
  secretCipher    String?           @db.Text // AES-256-GCM sealed credentials
  // SHA-256 of the ingest token; the token itself is shown once.
  ingestTokenHash String?           @unique
  tokenPrefix     String?
  // Roles that can use this tool, in addition to explicitly assigned users.
  allowedRoles    UserRole[]        @default([])
  createdById     String?
  lastEventAt     DateTime?
  eventCount      Int               @default(0)
  lastError       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant      Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments IntegrationAssignment[]

  @@index([tenantId, category])
  @@map("integrations")
}

model IntegrationAssignment {
  integrationId String
  userId        String
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([integrationId, userId])
  @@map("integration_assignments")
}

model Endpoint {
  id          String    @id @default(cuid())
  tenantId    String?
  hostname    String
  os          String?
  ipAddress   String?
  owner       String?
  criticality String    @default("standard") // standard | high | critical
  // Asset group and type (lib/assets/inventory.ts); null = placed by its OS.
  assetClass  String?
  assetType   String?
  // Protection control → { status, product, updatedAt }; see src/lib/endpoints/controls.ts
  protections Json?
  isolated    Boolean   @default(false)
  isolatedAt  DateTime?
  isolatedBy  String?
  riskScore   Float     @default(0)
  lastSeenAt  DateTime?
  source      String    @default("telemetry") // telemetry | import | integration | manual
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, hostname])
  @@index([hostname])
  @@index([tenantId, assetClass])
  @@map("endpoints")
}

// ---------------------------------------------------------------------------
// AI agents — providers (online or local), per-agent profiles, run log.
// ---------------------------------------------------------------------------

enum AiAutonomy {
  OFF // agent disabled
  SUGGEST // analysis and recommendations only
  CONTAIN_WITH_APPROVAL // proposes containment; a human approves
  AUTO_CONTAIN // executes allowed containment above the confidence bar
}

// A client's AI choices (lib/ai/gateway): a provider per agent type, a
// monthly budget, and when budget alerts went out. What may run at all
// (residency, allowed providers, masking, user choice) is in the client's
// signed rulebook.
model TenantAiPolicy {
  tenantId           String   @id
  defaults           Json? // { [agentKey]: providerId }
  monthlyBudgetUsd   Float?
  budgetAlertMonth   String? // "2026-10" once the 80% alert went out
  budgetReachedMonth String? // once spend reached the budget
  updatedById        String?
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_policies")
}

// How well a model does each agent's job on the evaluation set
// (lib/ai/evals). A client-picked model without a passing score is capped at
// suggestions.
model ModelCapability {
  id          String   @id @default(cuid())
  model       String
  agentKey    String
  score       Float
  passed      Boolean
  cases       Int
  details     Json?
  evaluatedAt DateTime @default(now())

  @@unique([model, agentKey])
  @@map("model_capabilities")
}

model AiProvider {
  id               String    @id @default(cuid())
  name             String    @unique
  kind             String // anthropic | openai_compatible
  baseUrl          String?
  model            String
  apiKeyCipher     String?   @db.Text
  isLocal          Boolean   @default(false)
  enabled          Boolean   @default(true)
  isDefault        Boolean   @default(false)
  // Set for a client's own provider (bring your own key): used only for
  // that client. Null = a platform provider.
  tenantId         String?
  // Where inference runs, for region-locked clients ("india", "eu"…).
  region           String?
  lastCheckedAt    DateTime?
  lastCheckOk      Boolean?
  lastCheckMessage String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agents AiAgentProfile[]
  tenant Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("ai_providers")
}

model AiAgentProfile {
  id             String               @id @default(cuid())
  key            String               @unique // triage | containment | phishing | threat_intel | report | investigation
  name           String
  description    String?
  enabled        Boolean              @default(true)
  providerId     String? // null = platform default provider
  model          String? // overrides the provider's model
  autonomy       AiAutonomy           @default(SUGGEST)
  allowedActions PlaybookActionType[] @default([])
  minConfidence  Float                @default(0.8)
  effort         String               @default("medium") // low | medium | high
  instructions   String?              @db.Text
  updatedAt      DateTime             @updatedAt

  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@map("ai_agent_profiles")
}

model AiRun {
  id            String   @id @default(cuid())
  caseId        String?
  // The client the run was for, and why this model ran it (lib/ai/gateway).
  tenantId      String?
  resolution    Json?
  agentKey      String
  trigger       String // auto | manual
  engine        String // provider name, or "built-in"
  model         String?
  isLocal       Boolean  @default(false)
  status        String // succeeded | fallback | failed
  confidence    Float?
  output        Json?
  grounding     Json? // claims checked against case evidence
  error         String?  @db.Text
  durationMs    Int?
  inputTokens   Int?
  outputTokens  Int?
  requestedById String?
  feedback      String? // agree | disagree
  feedbackNote  String?
  feedbackById  String?
  createdAt     DateTime @default(now())

  case       Case?            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  feedbackBy User?            @relation("AiRunFeedback", fields: [feedbackById], references: [id], onDelete: SetNull)
  actions    ResponseAction[]

  @@index([caseId, createdAt])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("ai_runs")
}

// One containment step on one target, proposed by an AI agent or requested
// by an analyst, and gated by the response policy (src/lib/response/policy.ts).
enum OrgPolicyStatus {
  DRAFT
  AWAITING_SIGNATURE
  ACTIVE
  SUPERSEDED
}

// A client's rulebook (lib/rulebook): what HELIOS may do on its estate,
// versioned, hashed and signed by the client. One ACTIVE version at a time;
// the response policy reads it on every decision.
model OrgPolicy {
  id             String          @id @default(cuid())
  tenantId       String
  version        Int
  status         OrgPolicyStatus @default(DRAFT)
  body           Json
  contentHash    String
  template       String?
  reason         String?         @db.Text
  authoredById   String?
  authoredByName String
  submittedAt    DateTime?
  signedById     String?
  signedByName   String?
  signedAt       DateTime?
  signatureNote  String?         @db.Text
  effectiveFrom  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, version])
  @@index([tenantId, status])
  @@map("org_policies")
}

// Known-good activity a client vouches for (a vulnerability scanner, an
// admin tool, an expected job): each with an owner, a reason and an expiry.
model PolicyAllowlistEntry {
  id          String    @id @default(cuid())
  tenantId    String
  kind        String // ip | host | user | domain | hash | process | sender
  value       String
  reason      String
  owner       String
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, kind, value])
  @@map("policy_allowlist")
}

enum ResponseActionStatus {
  SUGGESTED // recommendation only — autonomy doesn't allow acting
  PENDING_APPROVAL
  EXECUTED
  REJECTED
  FAILED
  BLOCKED // failed a guardrail (ungrounded target, kill switch, ...)
  ROLLED_BACK
  // Approved, but no response connector can carry it out: someone does it
  // in the tool's own console and marks it done here.
  MANUAL_REQUIRED
}

model ResponseAction {
  id                String               @id @default(cuid())
  caseId            String
  tenantId          String?
  actionType        PlaybookActionType
  target            String?
  parameters        Json?
  source            String // ai | analyst
  status            ResponseActionStatus
  rationale         String?              @db.Text
  confidence        Float?
  policyReason      String?
  aiRunId           String?
  requestedById     String?
  decidedById       String?
  decidedAt         DateTime?
  // The two-person rule: approvals needed, and who has approved so far
  // ([{ id, name, at }]).
  requiredApprovals Int                  @default(1)
  approvals         Json?
  // The client rulebook version that decided, and every rule that
  // restricted the action (lib/response/policy.ts).
  policyVersion     Int?
  policyHash        String?
  trace             Json?
  // Where it is in the client's approver chain: { step, at, timedOut }.
  escalation        Json?
  result            Json?
  createdAt         DateTime             @default(now())

  case  Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  aiRun AiRun? @relation(fields: [aiRunId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([caseId])
  @@map("response_actions")
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Commercial — quotes from the Build & Price configurator.
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  LOST
}

model Quote {
  id           String      @id @default(cuid())
  reference    String      @unique // Q-2026-0001
  clientName   String
  tenantId     String?
  status       QuoteStatus @default(DRAFT)
  currency     String      @default("USD")
  config       Json
  totals       Json
  notes        String?     @db.Text
  validUntil   DateTime?
  // app: built in Build & Price · website: requested from the public estimator
  source       String      @default("app")
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source, createdAt])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// Reference data — all admin-managed. The seed only loads verifiable facts
// (published vendor list prices with their source, Anthropic's published
// model prices, public threat feeds); company policy such as rates, SLAs and
// exchange rates starts empty.
// ---------------------------------------------------------------------------

model ServicePlan {
  id                 String     @id @default(cuid())
  key                String     @unique
  name               String
  tagline            String?
  coverage           String // e.g. "24x7", "8x5"
  // Minutes to acknowledge / contain, by severity ({ "CRITICAL": 30, ... }).
  ackMinutes         Json
  containMinutes     Json
  irRetainerHours    Int        @default(0)
  pricePerEndpoint   Float? // monthly sell price, USD
  costPerEndpoint    Float? // your monthly delivery cost, USD
  onboardingMinimum  Float?
  defaultAutonomyCap AiAutonomy @default(CONTAIN_WITH_APPROVAL)
  features           Json // { "threatHunting": "Monthly", ... }
  active             Boolean    @default(true)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenants Tenant[]

  @@map("service_plans")
}

// Your own service rates and commercial terms (keys in src/lib/pricing/items.ts).
model PriceItem {
  key         String   @id
  group       String
  label       String
  unit        String
  price       Float?
  cost        Float?
  note        String?
  sortOrder   Int      @default(0)
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("price_items")
}

model VolumeDiscount {
  minEndpoints Int      @id
  discountPct  Float
  updatedAt    DateTime @updatedAt

  @@map("volume_discounts")
}

// Third-party security tools HELIOS can onboard and price.
model CatalogTool {
  key            String               @id
  name           String
  vendor         String
  category       String
  description    String
  controls       String[]
  actions        PlaybookActionType[]
  ingest         String? // payload mapper, src/lib/integrations/mappers.ts
  platforms      String[]
  deployment     String
  offlineCapable Boolean              @default(false)
  priceUnit      String // endpoint | user | server | gb | flat
  // Vendor-published list price, USD per unit per month, with its source.
  listPrice      Float?
  priceSource    String?
  // What you actually pay or resell at; overrides listPrice in quotes.
  customPrice    Float?
  active         Boolean              @default(true)
  updatedAt      DateTime             @updatedAt

  @@map("catalog_tools")
}

model Currency {
  code        String   @id // ISO 4217
  symbol      String
  rate        Float // units per 1 USD
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("currencies")
}

// Model prices for AI spend estimates (USD per million tokens).
model AiModelPrice {
  model     String   @id
  provider  String
  inputPer  Float
  outputPer Float
  source    String?
  updatedAt DateTime @updatedAt

  @@map("ai_model_prices")
}

// Public or private indicator feeds imported into the threat-intel store.
model ThreatFeed {
  id             String        @id @default(cuid())
  name           String        @unique
  url            String
  indicatorType  IndicatorType
  maliciousScore Float         @default(0.8)
  description    String?
  enabled        Boolean       @default(false)
  lastImportedAt DateTime?
  lastCount      Int?
  lastError      String?
  createdAt      DateTime      @default(now())

  @@map("threat_feeds")
}
