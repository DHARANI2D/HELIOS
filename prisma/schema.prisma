// HELIOS unified schema
// Consolidates aegis (agent governance), asip (SOC investigations),
// desas (email/file forensics), and signal-fusion (SIEM alerts) into
// one shared data model. See /legacy/components/* for the four
// original per-app schemas this replaces.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

// What a user may do. The permission matrix lives in src/lib/rbac.ts; staff
// roles serve every client tenant, CLIENT_* roles see only their own.
enum UserRole {
  ANALYST // Tier-2 SOC analyst: primary analysis
  ADMIN // platform owner
  SOC_MANAGER
  TRIAGE_ANALYST // Tier-1
  INCIDENT_RESPONDER // Tier-3 / IR lead
  THREAT_HUNTER
  DETECTION_ENGINEER
  AUDITOR
  SALES
  CLIENT_ADMIN
  CLIENT_VIEWER
}

// Analyst queues. A case gets one domain; analysts with domains set see
// those queues (plus whatever is assigned to them).
enum SecurityDomain {
  ENDPOINT
  NETWORK
  EMAIL
  IDENTITY
  CLOUD
  AI_AGENTS
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  name              String?
  passwordHash      String?
  role              UserRole         @default(ANALYST)
  tenantId          String? // set for client users; null for MSSP staff
  title             String?
  domains           SecurityDomain[] @default([])
  active            Boolean          @default(true)
  lastLoginAt       DateTime?
  failedLogins      Int              @default(0)
  lockedUntil       DateTime?
  // Two-step sign-in (lib/mfa): the TOTP secret, sealed; hashes of the
  // unused recovery codes; the last time step accepted (no replays).
  mfaSecretCipher   String?
  mfaEnabledAt      DateTime?
  mfaRecoveryHashes String[]         @default([])
  mfaLastStep       Int?
  preferences       Json?
  // For alerts by SMS and WhatsApp (E.164), and which notification kinds
  // also go out by email, SMS or WhatsApp (lib/alerts): { kind: [channels] }.
  phone             String?
  alertPrefs        Json?
  createdAt         DateTime         @default(now())

  tenant                 Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accounts               Account[]
  sessions               Session[]
  assignedCases          Case[]                  @relation("CaseAssignee")
  auditLogs              AuditLog[]
  approvals              PlaybookApproval[]
  notifications          Notification[]
  comments               CaseComment[]
  watching               CaseWatcher[]
  integrationAssignments IntegrationAssignment[]
  quotes                 Quote[]
  aiFeedback             AiRun[]                 @relation("AiRunFeedback")
  apiTokens              ApiToken[]
  alertDeliveries        AlertDelivery[]
  onCallShifts           OnCallShift[]

  @@index([tenantId])
  @@map("users")
}

// Personal access tokens for the REST API (/api/v1). A token acts as its
// user — same role, client and queues — narrowed to read or read-write.
// Stored only as a SHA-256 hash.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  userId     String
  tokenHash  String    @unique
  prefix     String // first characters, to recognize it in lists
  canWrite   Boolean   @default(false)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Client tenants — the organizations the SOC protects.
// ---------------------------------------------------------------------------

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                    String       @id @default(cuid())
  name                  String       @unique
  slug                  String       @unique
  industry              String?
  status                TenantStatus @default(ONBOARDING)
  planId                String? // the managed-service plan the client is on (sets its SLA)
  contactName           String?
  contactEmail          String?
  endpointsLicensed     Int          @default(0)
  usersLicensed         Int          @default(0)
  // The most autonomy the client has consented to for AI agents acting on
  // its estate; caps every agent profile.
  aiAutonomyCap         AiAutonomy   @default(CONTAIN_WITH_APPROVAL)
  // Circuit breaker: automatic containment paused for this client after
  // repeated connector failures, until someone resumes it.
  // Log retention (lib/retention): events stay searchable in the database
  // for logHotDays, then move to the archive, which is deleted after
  // logRetentionDays (at least 180 where CERT-In applies). Events on a case
  // are kept with it.
  logHotDays            Int          @default(90)
  logRetentionDays      Int          @default(365)
  automationPausedAt    DateTime?
  automationPauseReason String?
  notes                 String?      @db.Text
  // Who invoices go to (lib/billing): { legalName, gstin, address, state,
  // country, email, poNumber }.
  billingProfile        Json?
  // Test clients hold test data only: badged everywhere, kept out of
  // commercial figures, and never a real organization.
  isTest                Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  plan         ServicePlan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  users        User[]
  cases        Case[]
  events       SecurityEvent[]
  endpoints    Endpoint[]
  integrations Integration[]
  agents       Agent[]
  quotes       Quote[]
  policies     OrgPolicy[]
  allowlist    PolicyAllowlistEntry[]
  aiProviders  AiProvider[]
  aiPolicy     TenantAiPolicy?
  autonomy     AutonomyLevel[]
  keys         TenantKey[]
  notices      RegulatoryNotice[]
  tunings      DetectionTuning[]
  archives     EventArchive[]
  legalHolds   LegalHold[]
  contracts    Contract[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Unified case model — replaces aegis.BreachInvestigation, asip.Investigation,
// desas's per-email AnalysisResult, and signal-fusion.Alert.
// ---------------------------------------------------------------------------

enum CaseSource {
  AGENT_GOVERNANCE // aegis
  SOC_INVESTIGATION // asip
  EMAIL_ANALYSIS // desas
  SIEM_ALERT // signal-fusion
}

enum CaseSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseDisposition {
  TRUE_POSITIVE
  BENIGN_TRUE_POSITIVE // real activity, but expected or authorised
  FALSE_POSITIVE
}

enum CaseStatus {
  OPEN
  TRIAGING
  INVESTIGATING
  AWAITING_APPROVAL
  CONTAINED
  RESOLVED
  FALSE_POSITIVE
}

model Case {
  id                 String           @id @default(cuid())
  sourceType         CaseSource
  title              String
  summary            String?          @db.Text
  severity           CaseSeverity     @default(MEDIUM)
  status             CaseStatus       @default(OPEN)
  confidence         Float? // 0-1, e.g. asip's QA-validated confidence score
  verdict            String? // e.g. desas "malicious"/"suspicious"/"clean"
  riskScore          Float?
  assignedToId       String?
  sourceRef          String? // originating agentId / investigationId / alertId / emailId
  rootCauseNarrative String?          @db.Text
  metadata           Json? // source-specific payload (headers, IOC lists, etc.)
  tenantId           String?
  domain             SecurityDomain?
  tier               Int              @default(1) // escalation tier: 1 triage, 2 analysis, 3 incident response
  slaDueAt           DateTime? // acknowledge-by deadline from the tenant's plan
  acknowledgedAt     DateTime?
  containedAt        DateTime?
  aiStatus           String? // queued | running | completed | failed | skipped
  // The analyst's call when closing: the ground truth AI is measured against.
  disposition        CaseDisposition?
  dispositionReason  String?          @db.Text
  dispositionById    String?
  dispositionAt      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  resolvedAt         DateTime?

  tenant          Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedTo      User?                @relation("CaseAssignee", fields: [assignedToId], references: [id])
  detections      Detection[]
  timeline        TimelineEntry[]
  mitreTechniques CaseMitreTechnique[]
  indicators      CaseIndicator[]
  playbookRuns    PlaybookExecution[]
  auditLogs       AuditLog[]
  events          SecurityEvent[]
  comments        CaseComment[]
  watchers        CaseWatcher[]
  aiRuns          AiRun[]
  notifications   Notification[]
  responseActions ResponseAction[]
  aiOutcomes      AiDecisionOutcome[]
  runbooks        CaseRunbook[]
  qaReviews       QaReview[]
  notices         RegulatoryNotice[]

  @@index([tenantId, status])
  @@index([domain, status])
  @@index([sourceType, status])
  @@index([sourceType, sourceRef])
  @@index([severity])
  @@map("cases")
}

// One shared timeline for every case, replacing asip.TimelineEntry,
// aegis's JSON evidence blob, and desas's per-analysis narrative.
model TimelineEntry {
  id         String   @id @default(cuid())
  caseId     String
  occurredAt DateTime
  actor      String? // process/user/agent name
  action     String
  detail     String?  @db.Text
  evidence   Json?
  createdAt  DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, occurredAt])
  @@map("timeline_entries")
}

// Normalized telemetry — one Universal Event Schema for signal-fusion's
// auth/endpoint/network/cloud adapters and asip's Sysmon/CrowdStrike/Splunk/
// Wazuh/Google SecOps parsers. Detection runs over a window of these rows;
// events tied to an investigation carry its caseId.
model SecurityEvent {
  id                String   @id @default(cuid())
  batchId           String? // one ingestion run / uploaded file
  caseId            String?
  timestamp         DateTime
  ingestedAt        DateTime @default(now())
  source            String // auth | endpoint | network | cloud | process | file | ...
  platform          String? // originating product/parser, e.g. "sysmon", "crowdstrike"
  eventType         String
  userName          String?
  hostName          String?
  service           String?
  processName       String?
  processPid        Int?
  parentProcessName String?
  parentProcessPid  Int?
  commandLine       String?  @db.Text
  sourceIp          String?
  destIp            String?
  destPort          Int?
  geo               String?
  filePath          String?  @db.Text
  fileHash          String?
  severityHint      String?
  metadata          Json?
  tenantId          String?
  integrationId     String? // set when pushed through an onboarded tool's webhook
  // The event in OCSF form and its class (lib/ocsf): sources mapped
  // OCSF-first derive the columns above from it; the others derive it from them.
  classUid          Int?
  ocsf              Json?
  // The source's own event id: an event pulled or sent twice is stored once.
  sourceEventId     String?

  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([integrationId, sourceEventId])
  @@index([tenantId, classUid, timestamp])
  @@index([tenantId, timestamp])
  @@index([timestamp])
  @@index([caseId])
  @@index([batchId])
  @@map("security_events")
}

// Replaces signal-fusion's 11 detector outputs, aegis's DLP/reasoning/
// behavioral/trust triggers, and desas's forensic rule hits.
enum DetectionSource {
  GEO_VELOCITY
  FSM_CHAIN
  ANOMALOUS_ACTION
  THREAT_INTEL_MATCH
  RECONNAISSANCE
  CREDENTIAL_HARVESTING
  LATERAL_MOVEMENT
  DATA_EXFILTRATION
  PERSISTENCE
  DEFENSE_EVASION
  IMPACT
  AGENT_INTENT_POLICY
  AGENT_DLP
  AGENT_REASONING_DRIFT
  AGENT_TRUST_DECAY
  EMAIL_HEADER_AUTH
  EMAIL_BODY_URL
  EMAIL_ATTACHMENT_FORENSICS
  EMAIL_SANDBOX_DETONATION
  VENDOR_ALERT // raised by an onboarded tool (EDR, identity, email gateway)
  SIGMA_RULE // an imported Sigma rule (lib/detections)
}

model Detection {
  id          String          @id @default(cuid())
  caseId      String
  source      DetectionSource
  ruleId      String
  title       String
  severity    CaseSeverity
  evidence    Json
  // Stable hash of detector + matched event IDs, so re-running detection over
  // an overlapping event window never files the same finding twice.
  fingerprint String?         @unique
  createdAt   DateTime        @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([source])
  @@map("detections")
}

// ---------------------------------------------------------------------------
// MITRE ATT&CK — one shared reference set for asip, desas, and signal-fusion
// mappings instead of three separate copies.
// ---------------------------------------------------------------------------

model MitreTactic {
  id         String           @id // e.g. "TA0001"
  name       String
  techniques MitreTechnique[]

  @@map("mitre_tactics")
}

model MitreTechnique {
  id             String  @id // e.g. "T1566" or "T1566.001"
  tacticId       String
  name           String
  description    String? @db.Text
  isSubtechnique Boolean @default(false)
  parentId       String?

  tactic MitreTactic          @relation(fields: [tacticId], references: [id])
  cases  CaseMitreTechnique[]

  @@map("mitre_techniques")
}

model CaseMitreTechnique {
  caseId      String
  techniqueId String
  confidence  Float?

  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  technique MitreTechnique @relation(fields: [techniqueId], references: [id])

  @@id([caseId, techniqueId])
  @@map("case_mitre_techniques")
}

// ---------------------------------------------------------------------------
// Threat intelligence — one shared IOC cache for asip, desas, signal-fusion
// (VirusTotal / AbuseIPDB / MxToolbox) instead of three ad hoc caches.
// ---------------------------------------------------------------------------

enum IndicatorType {
  IP
  DOMAIN
  URL
  FILE_HASH
  EMAIL_ADDRESS
}

model ThreatIndicator {
  id             String        @id @default(cuid())
  type           IndicatorType
  value          String
  maliciousScore Float? // normalized 0-1 across providers
  providerData   Json // raw VT / AbuseIPDB / MxToolbox responses
  sources        String[] // providers that contributed to maliciousScore
  blockedAt      DateTime? // set by the BLOCK_IP playbook action
  lastCheckedAt  DateTime      @default(now())
  expiresAt      DateTime // cache TTL (24h default, matching signal-fusion)

  caseLinks CaseIndicator[]

  @@unique([type, value])
  @@index([expiresAt])
  @@map("threat_indicators")
}

model CaseIndicator {
  caseId      String
  indicatorId String
  role        String? // e.g. "c2_destination", "sender_ip", "dropped_file_hash"

  case      Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  indicator ThreatIndicator @relation(fields: [indicatorId], references: [id])

  @@id([caseId, indicatorId])
  @@map("case_indicators")
}

// ---------------------------------------------------------------------------
// Agent governance (aegis) — distinct concept, kept close to source model.
// ---------------------------------------------------------------------------

enum AgentStatus {
  ACTIVE
  ISOLATED
  REVOKED
}

model Agent {
  id           String      @id @default(cuid())
  name         String      @unique
  publicKey    String
  trust        Float       @default(100)
  level        Int         @default(10) // L0 (isolated) - L10 (full access)
  status       AgentStatus @default(ACTIVE)
  mode         String?
  tenantId     String?
  // SHA-256 of the agent's API token for POST /api/governance/evaluate.
  apiTokenHash String?     @unique
  tokenPrefix  String?
  createdAt    DateTime    @default(now())
  lastUpdateAt DateTime    @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("agents")
}

// ---------------------------------------------------------------------------
// Response playbooks (signal-fusion) — generalized to trigger from any
// Case, not just SIEM alerts.
// ---------------------------------------------------------------------------

model Playbook {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  triggerCondition Json // e.g. { severity: "CRITICAL", sourceType: "SIEM_ALERT" }
  enabled          Boolean  @default(true)
  autoExecute      Boolean  @default(false)
  requireApproval  Boolean  @default(true)
  priority         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  actions    PlaybookAction[]
  executions PlaybookExecution[]

  @@map("playbooks")
}

enum PlaybookActionType {
  ISOLATE_HOST
  BLOCK_IP
  NOTIFY_SLACK
  CREATE_TICKET
  KILL_PROCESS
  COLLECT_LOGS
  REVOKE_AGENT
  RESTORE_AGENT
  DISABLE_USER
  QUARANTINE_FILE
  BLOCK_SENDER
  // Remove a delivered message from its recipients' mailboxes.
  PURGE_EMAIL
  // Set a new password (required to change at next sign-in) and end sessions.
  RESET_PASSWORD
  // Rollbacks for the containment actions above.
  RELEASE_HOST
  UNBLOCK_IP
  ENABLE_USER
}

model PlaybookAction {
  id         String             @id @default(cuid())
  playbookId String
  name       String
  actionType PlaybookActionType
  parameters Json
  order      Int

  playbook Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@map("playbook_actions")
}

enum PlaybookExecutionStatus {
  PENDING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED
}

model PlaybookExecution {
  id          String                  @id @default(cuid())
  playbookId  String
  caseId      String
  status      PlaybookExecutionStatus @default(PENDING_APPROVAL)
  triggeredBy String                  @default("auto") // auto | manual | retroactive
  results     Json?
  error       String?
  startedAt   DateTime                @default(now())
  finishedAt  DateTime?

  playbook  Playbook           @relation(fields: [playbookId], references: [id])
  case      Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvals PlaybookApproval[]

  @@index([status])
  @@map("playbook_executions")
}

model PlaybookApproval {
  id          String   @id @default(cuid())
  executionId String
  approverId  String
  decision    String // "approved" | "rejected"
  notes       String?
  decidedAt   DateTime @default(now())

  execution PlaybookExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  approver  User              @relation(fields: [approverId], references: [id])

  @@map("playbook_approvals")
}

// ---------------------------------------------------------------------------
// Audit log — one hash-chained trail for every write action app-wide
// (generalized from aegis.AuditLog).
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  // Monotonic chain position. createdAt alone can tie within a millisecond,
  // which would make the verification order ambiguous.
  seq         Int      @unique @default(autoincrement())
  actorId     String?
  caseId      String?
  action      String
  detail      Json?
  prevHash    String
  currentHash String
  signature   String?
  createdAt   DateTime @default(now())

  // Restrict, not SetNull: nulling these on delete would rewrite hashed
  // fields and break the chain. Close cases / deactivate users instead.
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  case  Case? @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Collaboration — discussion, watchers, notifications.
// ---------------------------------------------------------------------------

model CaseComment {
  id         String   @id @default(cuid())
  caseId     String
  authorId   String?
  authorName String
  kind       String   @default("comment") // comment | handoff | escalation | share | ai
  body       String   @db.Text
  // Internal comments are hidden from client users.
  internal   Boolean  @default(true)
  mentions   String[] @default([]) // user ids
  createdAt  DateTime @default(now())

  case   Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("case_comments")
}

model CaseWatcher {
  caseId    String
  userId    String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([caseId, userId])
  @@map("case_watchers")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // mention | assigned | escalated | shared | watching | approval | ai | sla
  title     String
  body      String?   @db.Text
  href      String?
  caseId    String?
  actorName String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Onboarded security tools and the endpoint estate they protect.
// ---------------------------------------------------------------------------

enum IntegrationStatus {
  PENDING // created, no data yet
  CONNECTED
  DEGRADED
  DISCONNECTED
}

model Integration {
  id                String            @id @default(cuid())
  tenantId          String?
  vendor            String // tool key, src/lib/integrations/catalog.ts
  category          String // category key
  name              String
  status            IntegrationStatus @default(PENDING)
  enabled           Boolean           @default(true)
  config            Json? // non-secret settings
  secretCipher      String?           @db.Text // AES-256-GCM sealed credentials
  // SHA-256 of the ingest token; the token itself is shown once.
  ingestTokenHash   String?           @unique
  tokenPrefix       String?
  // Roles that can use this tool, in addition to explicitly assigned users.
  allowedRoles      UserRole[]        @default([])
  createdById       String?
  lastEventAt       DateTime?
  eventCount        Int               @default(0)
  lastError         String?
  // Source health (lib/ingest/health): how long it may be silent before
  // that is itself a finding (null: by category), and the open quiet spell.
  quietAfterMinutes Int?
  quietSince        DateTime?
  quietCaseId       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant      Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments IntegrationAssignment[]
  batches     IngestBatch[]
  deadLetters IngestDeadLetter[]
  checkpoints CollectorCheckpoint[]
  healthHours SourceHealthHour[]

  @@index([tenantId, category])
  @@map("integrations")
}

enum IngestBatchStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

// Raw batches between the ingest edge and the normalisers (lib/ingest): the
// edge only authenticates, stamps and stores; workers map, enrich and detect.
model IngestBatch {
  id            String            @id @default(cuid())
  tenantId      String?
  integrationId String
  channel       String // push | pull | forwarder
  stream        String? // a pull collector's stream, e.g. entra.signins
  // The mapper to read it with, when not the tool's own (a pull stream's).
  format        String?
  status        IngestBatchStatus @default(QUEUED)
  // The body as received (after decompression); cleared once processed.
  payload       String            @db.Text
  bytes         Int
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  error         String?
  result        Json?
  receivedAt    DateTime          @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([tenantId, status])
  @@index([integrationId, receivedAt])
  @@map("ingest_batches")
}

// Where each pull-collector stream has got to (lib/collectors).
model CollectorCheckpoint {
  integrationId String
  stream        String // e.g. entra.signins
  cursor        String?   @db.Text
  nextPollAt    DateTime  @default(now())
  lastPolledAt  DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  failures      Int       @default(0)
  records       Int       @default(0)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([integrationId, stream])
  @@index([nextPollAt])
  @@map("collector_checkpoints")
}

// Events stored per source per hour: the source-health chart and baseline.
model SourceHealthHour {
  integrationId String
  hour          DateTime
  events        Int      @default(0)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([integrationId, hour])
  @@map("source_health_hours")
}

// Records no mapper could read, kept as received so they can be fixed and replayed.
model IngestDeadLetter {
  id            String    @id @default(cuid())
