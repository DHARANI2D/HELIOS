# The box's name as HELIOS reaches it. A public DNS name gets a certificate
# from Let's Encrypt; a private one needs AI_BOX_TLS="tls internal".
AI_BOX_HOST=ai-box.client.example
# A long random key; HELIOS sends it as its API key. Generate one with:
#   openssl rand -hex 32
AI_BOX_KEY=
# The model HELIOS asks for (the same name goes in HELIOS's provider form).
AI_BOX_MODEL=qwen2.5:14b
# Leave blank for a public certificate; "tls internal" for Caddy's own CA.
AI_BOX_TLS=
# ollama:11434 (default) or vllm:8000 with the vllm profile.
AI_BOX_UPSTREAM=ollama:11434
# vLLM only: the Hugging Face model to serve and a token if it's gated.
AI_BOX_VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
HUGGING_FACE_HUB_TOKEN=
