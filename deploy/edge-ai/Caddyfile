# Only HELIOS's calls, only with the box's key; everything else is refused.
# How the box gets its certificate, and whether it requires HELIOS's
# (mutual TLS), is in tls.caddy.
{$AI_BOX_HOST} {
	import /etc/caddy/tls.caddy

	@helios {
		method GET POST
		path /v1/chat/completions /v1/models
		header Authorization "Bearer {$AI_BOX_KEY}"
	}
	handle @helios {
		request_body {
			max_size 8MB
		}
		reverse_proxy {$AI_BOX_UPSTREAM} {
			transport http {
				read_timeout 5m
			}
		}
	}
	handle {
		respond "Not allowed" 401
	}

	log {
		output stdout
		format json
	}
}
