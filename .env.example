# Postgres connection used by Prisma
DATABASE_URL="postgresql://helios:helios@localhost:5432/helios?schema=public"

# Auth.js — generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-me"
AUTH_URL="http://localhost:3000"

# --- Threat intelligence providers (optional) --------------------------------
# Shared by every module through the ThreatIndicator cache. Without keys,
# HELIOS uses its built-in intel (known C2 / Tor ranges, suspicious TLDs,
# brand-impersonation heuristics) only.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- Investigations ----------------------------------------------------------
# With an Anthropic key the triage → RCA → QA → report pipeline runs as a
# Claude agent swarm; without one it uses the deterministic forensic engine.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL="claude-opus-5-5"
# Force an engine regardless of credentials: "claude" | "heuristic"
# INVESTIGATIONS_ENGINE=

# --- Response playbooks ------------------------------------------------------
# NOTIFY_SLACK actions post here; without it they are recorded as simulated.
SLACK_WEBHOOK_URL=

# --- Email & file forensics --------------------------------------------------
# Extra domains whose links are never analyzed or detonated (comma-separated).
FORENSICS_DOMAIN_WHITELIST=
# Set to "false" to skip the _dmarc TXT lookup for sender domains.
# FORENSICS_DNS_LOOKUPS=true
# Verdict thresholds (desas defaults).
# FORENSICS_MALICIOUS_THRESHOLD=71
# FORENSICS_SUSPICIOUS_THRESHOLD=31

# --- Seeding -----------------------------------------------------------------
# SEED_ADMIN_EMAIL="admin@helios.local"
# SEED_ADMIN_PASSWORD="helios-admin"
