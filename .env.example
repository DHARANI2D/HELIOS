# Postgres connection used by Prisma
DATABASE_URL="postgresql://helios:helios@localhost:5432/helios?schema=public"

# Auth.js — generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Key for secrets stored in the database (integration secrets, AI provider
# keys), AES-256-GCM. 32 bytes, base64. Without it a key is derived from
# AUTH_SECRET — set it explicitly in production so rotating AUTH_SECRET
# doesn't make stored secrets unreadable.
HELIOS_ENCRYPTION_KEY=""

# --- AI agents ----------------------------------------------------------------
# Online: Claude through the Anthropic API. Providers (including local,
# offline models via Ollama, LM Studio or vLLM) are also configured in the
# app under AI Agents, which takes precedence over this key.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL="claude-opus-5-5"
# Force every agent onto the built-in deterministic engine: "builtin"
# HELIOS_AI_ENGINE=
# Turn off automatic AI first response on new cases: "off"
# HELIOS_AI_FIRST_RESPONSE=
# How many agent runs may execute at once (default 2).
# AI_MAX_CONCURRENT_RUNS=2
# Request timeout for local / OpenAI-compatible models in ms (default 180000).
# AI_LOCAL_TIMEOUT_MS=180000
# Investigations pipeline engine regardless of credentials: "claude" | "heuristic"
# INVESTIGATIONS_ENGINE=

# --- Threat intelligence providers (optional) --------------------------------
# Shared by every module through the indicator store. Without keys, IP and
# hash reputation comes only from the threat feeds you enable (Threat
# Intelligence → Threat feeds) and your own blocks. These keys (and the
# Slack webhook and MxToolbox key below) can instead be saved under Settings,
# encrypted; a saved key takes precedence over the variable.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- Chat ---------------------------------------------------------------------
# The SOC's own channel for NOTIFY_SLACK playbook steps when no Slack / Teams
# integration is onboarded. Without either, the step is left to do by hand.
SLACK_WEBHOOK_URL=

# --- Email & file forensics --------------------------------------------------
# Extra domains whose links are never analyzed or detonated (comma-separated).
FORENSICS_DOMAIN_WHITELIST=
# Set to "false" to skip the _dmarc TXT lookup for sender domains.
# FORENSICS_DNS_LOOKUPS=true
# MxToolbox sender-domain diagnostics (MX, blacklist, SPF, DMARC, DNS, SMTP,
# DKIM). Without a key the "Sender infrastructure" score component is skipped.
MXTOOLBOX_API_KEY=
# Default verdict thresholds (desas's); Settings → Forensics overrides them.
# FORENSICS_MALICIOUS_THRESHOLD=71
# FORENSICS_SUSPICIOUS_THRESHOLD=31
# Egress proxy for link detonation. Without it HTTPS_PROXY / HTTP_PROXY are
# used; "none" forces direct connections. Each hop is vetted before it leaves.
# DETONATION_PROXY=http://proxy.internal:3128

# --- Sign-in and encryption -----------------------------------------------------
# Single sign-on for staff with an OpenID Connect provider (Entra ID, Okta,
# Google, Keycloak…). Callback URL: <AUTH_URL>/api/auth/callback/sso
# HELIOS_SSO_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# HELIOS_SSO_CLIENT_ID=
# HELIOS_SSO_CLIENT_SECRET=
# HELIOS_SSO_NAME="Microsoft"
# The master key encrypted by AWS KMS (base64 CiphertextBlob of 32 random
# bytes), decrypted at startup instead of HELIOS_ENCRYPTION_KEY.
# HELIOS_ENCRYPTION_KEY_KMS=
# HELIOS_KMS_REGION=ap-south-1
# A plain database role that client-scoped transactions switch to, when the
# app's own database user bypasses row-level security (a superuser).
# HELIOS_DB_TENANT_ROLE=

# --- Outgoing mail ---------------------------------------------------------------
# Your SMTP server, for CERT-In reports and notices (or set it under Settings).
# HELIOS_SMTP_URL="smtps://user:password@smtp.example.com:465"
# The sender; defaults to the company email in Settings.
# HELIOS_MAIL_FROM="SOC <soc@example.com>"

# --- Log collection ------------------------------------------------------------
# The ingest workers (queue, pull collectors, source health) run in the web
# process. "external" leaves them to `npm run worker` processes.
# HELIOS_INGEST_WORKER=
# Batches a client may have waiting before its pushes get 429 (default 200).
# HELIOS_INGEST_MAX_PENDING=200
# All timed background jobs off (escalation, verification, ingest).
# HELIOS_BACKGROUND_JOBS=

# --- Seeding -----------------------------------------------------------------
# The first platform admin. Without SEED_ADMIN_PASSWORD a random password is
# generated and printed once.
# SEED_ADMIN_EMAIL="admin@helios.local"
# SEED_ADMIN_NAME="Platform admin"
# SEED_ADMIN_PASSWORD=
# Test accounts from `npm run db:seed:test` (random and printed if unset).
# SEED_TEST_PASSWORD=
# The test seed refuses NODE_ENV=production unless this is "1".
# HELIOS_ALLOW_TEST_SEED=
